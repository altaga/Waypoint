# Waypoint environment variables. Names only: copy to .env for local runs (git-ignored).
# Never commit values. In GitHub, put secrets under Settings > Secrets and variables > Actions.

# --- Server runtime -------------------------------------------------------
# Local port. Ignored by Lambda.                                  [variable]
PORT=3000
# Comma-separated browser origins allowed besides localhost.       [variable]
WAYPOINT_ALLOWED_ORIGINS=
# 1 = no network calls (FX uses the snapshot). Set 0 in deployed environments. [variable]
WAYPOINT_OFFLINE=0
# Folder for the local file store (state.json). Lambda ignores this and uses DynamoDB (src/state-dynamo.ts). [variable]
WAYPOINT_DATA_DIR=

# --- Bedrock brain (src/brain.ts) ------------------------------------------
# bedrock turns on the brain; anything else keeps the local router.  [variable]
WAYPOINT_BRAIN=
# Bedrock model or inference-profile id. Required when the brain is on. No default. [variable]
WAYPOINT_BEDROCK_MODEL=
# Bedrock region.                                                  [variable]
AWS_REGION=us-east-1
# AWS credentials are read by the SDK's default chain. In Lambda, use the execution role
# (no keys). Locally, use AWS_PROFILE. Static keys are a last resort:
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=          [secret, only if no role is available]
# AWS_SECRET_ACCESS_KEY=      [secret, only if no role is available]
# AWS_SESSION_TOKEN=          [secret, only with temporary credentials]

# --- Alexa skill (src/alexa) -------------------------------------------------
# Skill id from the developer console. Requests with another id are rejected. [variable]
ALEXA_SKILL_ID=
# Public HTTPS URL of this server's /mcp, used by the skill. [variable]
WAYPOINT_MCP_URL=

# --- Browser smoke test (scripts/smoke-web.ts), optional --------------------
BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_MODULE=/path/to/playwright/index.js
# CHROME_PATH=/path/to/chromium

# --- Deploy (server / CI only — NEVER in the browser) ------------------------
# Role assumed by GitHub Actions through OIDC (no static keys in git). [variable]
# AWS_DEPLOY_ROLE_ARN=
#
# HARD RULE for the public demo:
# Do NOT use NEXT_PUBLIC_* / EXPO_PUBLIC_* / VITE_* / any client-bundled env for
# secrets, AWS keys, Bedrock model ids, Alexa tokens, or private service URLs.
# The web UI only calls same-origin paths (/mcp, /api/brain, /api/speech, /healthz).
# Bedrock, Polly, DynamoDB and skill credentials stay on the Lambda / GitHub Actions side.
