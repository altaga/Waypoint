{
  "$id": "https://github.com/altaga/travel-entry-packs/schema/pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "names": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "machine_extracted",
            "human_reviewed"
          ]
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reviewedBy",
        "reviewedAt"
      ],
      "additionalProperties": false
    },
    "localRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "prohibited_items",
              "medications",
              "conduct",
              "dress",
              "photography",
              "drugs",
              "alcohol",
              "lgbtq",
              "driving"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "fine",
              "arrest",
              "severe"
            ]
          },
          "summary": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "es": {
                "type": "string"
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "quote": {
            "type": "string",
            "minLength": 10
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastVerified": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "summary",
          "quote",
          "sources",
          "lastVerified",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "essentials": {
      "type": "object",
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "plugTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emergency": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "currency",
        "plugTypes",
        "emergency",
        "languages"
      ],
      "additionalProperties": false
    },
    "advisory": {
      "default": {},
      "type": "object",
      "properties": {
        "us": {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string"
            }
          },
          "required": [
            "level",
            "title",
            "date"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          },
          "retrieved": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "title",
          "url",
          "license",
          "retrieved"
        ],
        "additionalProperties": false
      }
    },
    "disclaimer": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "es": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "es"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "country",
    "names",
    "generatedAt",
    "tier",
    "review",
    "localRules",
    "essentials",
    "advisory",
    "sources",
    "disclaimer"
  ],
  "additionalProperties": false
}
