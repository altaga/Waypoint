{
  "name": "waypoint-alexa-mcp",
  "version": "0.1.0",
  "description": "Waypoint: a travel-readiness concierge exposed as a self-hosted MCP server (2025-11-25) for a simulated Alexa+ host.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts test/unit/*.test.ts",
    "start": "tsx src/server.ts",
    "fetch-sources": "tsx scripts/fetch-sources.ts",
    "build-packs": "tsx scripts/build-packs.ts",
    "eval": "tsx scripts/eval.ts",
    "validate": "npm run build-packs",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "validate-packs": "tsx scripts/validate-packs.ts",
    "export-schema": "tsx scripts/export-schema.ts",
    "ci": "npm run typecheck && npm test && npm run validate-packs && npm run eval",
    "smoke:brain": "tsx scripts/brain-smoke.ts",
    "build:lambda": "tsx scripts/build-lambda.ts",
    "cdk:synth": "npm run build:lambda && cdk synth --quiet",
    "cdk:deploy": "npm run build:lambda && cdk deploy --require-approval broadening",
    "build-world": "tsx scripts/build-world.ts",
    "build-city-stays": "tsx scripts/build-city-stays.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-polly": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@strands-agents/sdk": "^1.20.0",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-express-adapter": "^2.14.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "countries-list": "^3.4.1",
    "express": "^5.3.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1145.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
