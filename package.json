{
  "name": "waypoint-alexa-mcp",
  "version": "0.1.0",
  "description": "Waypoint: a travel-readiness concierge exposed as a self-hosted MCP server (2025-11-25) for a simulated Alexa+ host.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts test/unit/*.test.ts",
    "start": "tsx src/server.ts",
    "fetch-sources": "tsx scripts/fetch-sources.ts",
    "build-packs": "tsx scripts/build-packs.ts",
    "eval": "tsx scripts/eval.ts",
    "validate": "npm run build-packs",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "validate-packs": "tsx scripts/validate-packs.ts",
    "export-schema": "tsx scripts/export-schema.ts",
    "ci": "npm run typecheck && npm test && npm run validate-packs && npm run eval",
    "smoke:brain": "tsx scripts/brain-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@strands-agents/sdk": "^1.20.0",
    "countries-list": "^3.4.1",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
